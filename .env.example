# Copy to .env for local testing (never commit the real .env file).
# config.py loads this automatically via python-dotenv.
# In GitHub Actions, these are set as repo Secrets instead - see SETUP.md.

# --- Stages 1 & 2: Gemini API (script gen, review gate) ---
# NOTE: no Veo/video model key - the hero clips are generated manually in
# Flow and dropped into clip-pool/incoming/, not called via any API. See
# SETUP.md's "Human-in-the-loop architecture" section.
GEMINI_API_KEY=
# Optional override - default lives in scripts/common/config.py
# GEMINI_TEXT_MODEL=gemini-3.6-flash

# --- Stage 3: Edge TTS (optional override, no key needed) ---
TTS_VOICE=en-IN-NeerjaNeural

# --- Stage 4: Whisper (optional override, no key needed) ---
WHISPER_MODEL_SIZE=base

# --- Stage 5: stills via Pollinations.ai (free, no API key needed at all).
# Gemini's image models (Nano Banana, Nano Banana 2, Imagen) all turned out
# to be hard-locked to a 0 free-tier quota without billing attached - see
# SETUP.md's "Why images come from Pollinations, not Gemini" section.
# Set to force flat placeholder stills instead of real Pollinations calls:
# MOCK_STILLS=1

# CHARACTER_REF_URL / CHARACTER_REF_AUTH_HEADER are no longer needed by any
# automated stage - see SETUP.md's "Character reference" section.

# --- Stage 6: Assembly (optional override) ---
MUSIC_TRACK=

# --- Stage 7: YouTube upload ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted
